use flake . -j 44
# TUI-repo dev shell (docs/tui-ext-repo-split.md section 4, item 9).
# The `tui` binary resolves on PATH for `rushi`'s launcher contract
# (side-by-side, then PATH).
[ -d "$PWD/target/release" ] &&
	export PATH="$PWD/target/release:$PATH"

# The opt-in `ext-rs/` Rust extension binaries live in the sibling
# `rushi-exts` repo, not here. Put them on PATH by running the exts
# build helper (it builds all Rust extension entries and prints their
# target/debug dirs), e.g.:
#   export PATH="$(EXTS_ROOT=../rushi-exts bash ../rushi-exts/ext-env.sh):$PATH"
